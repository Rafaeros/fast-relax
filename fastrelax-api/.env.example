DB_URL=jdbc:postgresql://localhost:5432/<database>
DB_USER=username
DB_PASS=password
JWT_SECRET=sha256_key
AES_SECRET=aes_key

# Segredo compartilhado com o firmware do ESP32. O dispositivo envia em
# X-Device-Token no heartbeat, e a API envia de volta nos comandos do relé.
CHAIR_DEVICE_TOKEN=troque-este-token

# Origens liberadas no navegador, separadas por vírgula. Aceita curinga (*) no
# host e na porta. Mantenha apenas a máquina local e a rede interna: a API não
# deve ser alcançável de fora.
#   http://localhost         -> Next em dev na porta 80
#   http://localhost:*       -> qualquer porta local (3000, 5173...)
#   http://192.168.*.*:*     -> rede da empresa
#   http://10.*.*.*:*        -> outra faixa privada comum
# Se a rede usar a faixa 172.16–172.31, acrescente as sub-redes em uso
# (ex.: http://172.20.*.*:*).
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*,http://10.*.*.*:*
